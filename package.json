{
  "name": "feathers-queue",
  "version": "0.1.0",
  "description": "Cloud-agnostic task queue for Feathers.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "cd example && npm run dev",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:integration:docker": "docker-compose -f docker-compose.test.yml up --abort-on-container-exit",
    "test:e2e": "NODE_CONFIG_ENV=test vitest run test/e2e",
    "test:e2e:docker": "docker-compose -f docker-compose.e2e.yml up --abort-on-container-exit",
    "test:watch": "vitest",
    "test:docker:up": "docker-compose up -d",
    "test:docker:down": "docker-compose down",
    "test:docker:logs": "docker-compose logs -f",
    "test:docker:status": "docker-compose ps",
    "test:docker:e2e": "npm run test:docker:up && npm run test:e2e && npm run test:docker:down",
    "test:docker:full:up": "docker-compose up -d",
    "test:docker:full:down": "docker-compose down",
    "test:docker:full:logs": "docker-compose logs -f",
    "test:docker:full:status": "docker-compose ps",
    "test:docker:full": "npm run test:docker:full:up && sleep 10 && npm run test:e2e && npm run test:docker:full:down",
    "test:example:build": "npm run build && cd example && npm install",
    "test:example:dev": "npm run build && cd example && npm run dev",
    "test:example:docker:build": "cd example && docker-compose build",
    "test:example:docker:up": "cd example && docker-compose up",
    "test:example:docker:down": "cd example && docker-compose down",
    "test:example:docker:dev": "npm run build && cd example && docker-compose up",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:all:docker": "npm run test:unit && npm run test:integration:docker && npm run test:e2e:docker",
    "test:ci": "npm run test:unit && DOCKER_ENV=true npm run test:integration && npm run test:docker:full",
    "test:ci:docker": "npm run test:docker:all",
    "ngrok": "cd example && npm run dev && npx ngrok http 3030",
    "dev:ngrok": "cd example && npm run dev && npx ngrok http 3030",
    "test:live:build": "npm run build && cd example && npm install",
    "test:live:dev": "cd example && npm run dev",
    "test:live:ngrok": "cd example && npx ngrok http 3030",
    "test:live:start": "npm run test:live:build && npm run test:live:dev",
    "test:live:with-ngrok": "concurrently \"npm run test:live:start\" \"npm run test:live:ngrok\""
  },
  "keywords": [
    "feathers",
    "feathersjs",
    "queue",
    "task",
    "cloud",
    "gcp",
    "aws",
    "azure"
  ],
  "author": "James Villarrubia",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "@azure/storage-queue": "12.26.0",
    "@feathersjs/errors": "5.0.33",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/typebox": "5.0.33",
    "@grpc/grpc-js": "1.13.2",
    "debug": "4.4.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@feathersjs/express": "5.0.33",
    "@feathersjs/feathers": "5.0.33",
    "@google-cloud/tasks": "6.0.1",
    "@stepci/runner": "^2.0.7",
    "@types/debug": "^4.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "typescript": "^4.0.0",
    "vitest": "^3.0.0",
    "concurrently": "^8.2.2"
  },
  "peerDependencies": {
    "@feathersjs/feathers": "^5.0.0"
  },
  "files": [
    "dist"
  ]
}
