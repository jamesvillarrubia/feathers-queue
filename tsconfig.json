{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "declaration": true,
    "outDir": "hold/lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "feathers-queue": ["src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "hold", "exampleOLD", "dist", "example", "test", "**/*.test.ts"],
  "references": [
    { "path": "./example" }
  ]
}
