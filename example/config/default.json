{
  "host": "localhost",
  "port": 3030,
  "public": "../public/",
  "origins": [
    "http://localhost:3030"
  ],
  "paginate": {
    "default": 10,
    "max": 50
  },
  "pubsub": {
    "projectId": "test-project",
    "apiEndpoint": "http://pubsub:8085",
    "queues": {
      "basic-test-queue": {
        "name": "basic-test-queue",
        "topic": "basic-test-queue",
        "subscription": "basic-test-queue-sub",
        "process": true,
        "ackDeadlineSeconds": 30,
        "messageRetentionDuration": "7d",
        "enableMessageOrdering": true,
        "retryPolicy": {
          "minimumBackoff": "10s",
          "maximumBackoff": "600s"
        },
        "deadLetterPolicy": {
          "deadLetterTopic": "basic-test-queue-dlq",
          "maxDeliveryAttempts": 5
        }
      },
      "priority-test-queue": {
        "name": "priority-test-queue",
        "topic": "priority-test-queue",
        "subscription": "priority-test-queue-sub",
        "process": true,
        "ackDeadlineSeconds": 30,
        "messageRetentionDuration": "7d",
        "enableMessageOrdering": true,
        "retryPolicy": {
          "minimumBackoff": "10s",
          "maximumBackoff": "600s"
        },
        "deadLetterPolicy": {
          "deadLetterTopic": "priority-test-queue-dlq",
          "maxDeliveryAttempts": 5
        }
      },
      "push-test-queue": {
        "name": "push-test-queue",
        "topic": "push-test-queue",
        "subscription": "push-test-queue-sub",
        "process": true,
        "ackDeadlineSeconds": 30,
        "messageRetentionDuration": "7d",
        "pushConfig": {
          "pushEndpoint": "http://app:3030/push-handler",
          "attributes": {
            "queueName": "push-test-queue"
          }
        },
        "retryPolicy": {
          "minimumBackoff": "10s",
          "maximumBackoff": "600s"
        },
        "deadLetterPolicy": {
          "deadLetterTopic": "push-test-queue-dlq",
          "maxDeliveryAttempts": 5
        }
      }
    }
  }
}