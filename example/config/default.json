{
  "file": "default.json",
  "host": "localhost",
  "port": 3030,
  "public": "public",
  "feathers-queue": {
    "routing": true,
    "defaults": {
      "provider": "gcp",
      "projectId": "your-project-id",
      "location": "us-central1",
      "defaultQueue": "default",
      "queueName": "default",
      "maxRetries": 3,
      "retryDelay": 1000,
      "allowedDomains": ["localhost", "example.com"]
    },
    "queues": {
      "default": {
        "maxRetries": 3,
        "retryDelay": 1000
      },
      "high-priority": {
        "maxRetries": 5,
        "retryDelay": 500
      },
      "low-priority": {
        "maxRetries": 2,
        "retryDelay": 2000
      }
    },
    "emulator": {
      "host": "localhost",
      "port": "8123"
    }
  }
} 