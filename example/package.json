{
  "name": "example",
  "description": "Example usage of feathers-queue",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {},
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 23.10.0"
  },
  "feathers": {
    "language": "ts",
    "packager": "npm",
    "database": "other",
    "framework": "express",
    "transports": [
      "rest"
    ],
    "schema": "typebox"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "start": "node dist/index.js",
    "prettier": "npx prettier \"**/*.ts\" --write",
    "mocha": "cross-env NODE_ENV=test mocha test/ --require ts-node/register --recursive --extension .ts --exit",
    "test": "vitest run",
    "test:e2e": "cross-env NODE_ENV=test mocha test/e2e/ --require ts-node/register --recursive --extension .ts --exit",
    "bundle:client": "npm run compile && npm pack --pack-destination ./public"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "^5.0.33",
    "@feathersjs/authentication": "^5.0.33",
    "@feathersjs/authentication-client": "^5.0.33",
    "@feathersjs/configuration": "^5.0.33",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/express": "^5.0.33",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/schema": "^5.0.33",
    "@feathersjs/transport-commons": "^5.0.33",
    "@feathersjs/typebox": "^5.0.0",
    "compression": "^1.8.0",
    "feathers-queue": "file:..",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@feathersjs/cli": "^5.0.33",
    "@feathersjs/rest-client": "^5.0.33",
    "@types/express": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "axios": "^1.8.4",
    "cross-env": "^7.0.3",
    "mocha": "^11.1.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.5.3",
    "shx": "^0.3.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "vitest": "^0.34.0"
  }
}
